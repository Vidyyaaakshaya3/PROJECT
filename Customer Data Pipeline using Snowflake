----------- create merge tasks 

------- Task for nsw 

use schema curated;

CREATE OR REPLACE TASK LOAD_NSW_CUSTOMERS
WAREHOUSE = WH_CUSTOMER
WHEN SYSTEM$STREAM_HAS_DATA('CUSTOMER_DB.RAW.NSW_STREAM')
AS
MERGE INTO CUSTOMER_DB.CURATED.NSW_CUSTOMERS T
USING
(
    SELECT
        CUSTOMER_ID,
        CUSTOMER_NAME,
        CUSTOMER_EMAIL,
        CUSTOMER_CITY,
        CUSTOMER_STATE,
        CUSTOMER_DOB
    FROM CUSTOMER_DB.RAW.NSW_STREAM
    WHERE UPPER(CUSTOMER_STATE) IN ('NSW', 'NEW SOUTH WALES')
) S
ON T.CUSTOMER_ID = S.CUSTOMER_ID
WHEN MATCHED THEN
UPDATE SET
    CUSTOMER_NAME = S.CUSTOMER_NAME,
    CUSTOMER_EMAIL = S.CUSTOMER_EMAIL,
    CUSTOMER_CITY = S.CUSTOMER_CITY,
    CUSTOMER_STATE = S.CUSTOMER_STATE,
    CUSTOMER_DOB = S.CUSTOMER_DOB
WHEN NOT MATCHED THEN
INSERT
(
    CUSTOMER_ID,
    CUSTOMER_NAME,
    CUSTOMER_EMAIL,
    CUSTOMER_CITY,
    CUSTOMER_STATE,
    CUSTOMER_DOB
)
VALUES
(
    S.CUSTOMER_ID,
    S.CUSTOMER_NAME,
    S.CUSTOMER_EMAIL,
    S.CUSTOMER_CITY,
    S.CUSTOMER_STATE,
    S.CUSTOMER_DOB
);

----- Task for queensland 

CREATE OR REPLACE TASK LOAD_QUEENSLAND_CUSTOMERS
WAREHOUSE = WH_CUSTOMER
WHEN SYSTEM$STREAM_HAS_DATA('CUSTOMER_DB.RAW.QLD_STREAM')
AS
MERGE INTO CUSTOMER_DB.CURATED.QUEENSLAND_CUSTOMERS T
USING
(
    SELECT
        CUSTOMER_ID,
        CUSTOMER_NAME,
        CUSTOMER_EMAIL,
        CUSTOMER_CITY,
        CUSTOMER_STATE,
        CUSTOMER_DOB
    FROM CUSTOMER_DB.RAW.QLD_STREAM
    WHERE UPPER(CUSTOMER_STATE)
IN ('QLD','QUEENSLAND')
) S
ON T.CUSTOMER_ID = S.CUSTOMER_ID
WHEN MATCHED THEN
UPDATE SET
    CUSTOMER_NAME = S.CUSTOMER_NAME,
    CUSTOMER_EMAIL = S.CUSTOMER_EMAIL,
    CUSTOMER_CITY = S.CUSTOMER_CITY,
    CUSTOMER_STATE = S.CUSTOMER_STATE,
    CUSTOMER_DOB = S.CUSTOMER_DOB
WHEN NOT MATCHED THEN
INSERT
(
    CUSTOMER_ID,
    CUSTOMER_NAME,
    CUSTOMER_EMAIL,
    CUSTOMER_CITY,
    CUSTOMER_STATE,
    CUSTOMER_DOB
)
VALUES
(
    S.CUSTOMER_ID,
    S.CUSTOMER_NAME,
    S.CUSTOMER_EMAIL,
    S.CUSTOMER_CITY,
    S.CUSTOMER_STATE,
    S.CUSTOMER_DOB
);

