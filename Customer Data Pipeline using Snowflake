------- create table 

CREATE OR REPLACE TABLE RAW.CUSTOMERS
(
    CUSTOMER_ID NUMBER,
    CUSTOMER_NAME STRING,
    CUSTOMER_EMAIL STRING,
    CUSTOMER_CITY STRING,
    CUSTOMER_STATE STRING,
    CUSTOMER_DOB DATE
);

DESC TABLE RAW.CUSTOMERS;

--------- create task to load data into table 

CREATE OR REPLACE TASK LOAD_CUSTOMER_TASK
WAREHOUSE = WH_CUSTOMER
SCHEDULE = '1 MINUTE'
AS
COPY INTO RAW.CUSTOMERS
FROM @CUSTOMER_STAGE
FILE_FORMAT=(FORMAT_NAME=CUSTOMER_FILE_FORMAT);

ALTER TASK LOAD_CUSTOMER_TASK RESUME;

