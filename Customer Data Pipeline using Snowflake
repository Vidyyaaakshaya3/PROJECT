---------- Create row access policy

USE SCHEMA CUSTOMER_DB.CURATED;

CREATE OR REPLACE ROW ACCESS POLICY CITY_POLICY
AS (CUSTOMER_CITY STRING)
RETURNS BOOLEAN ->
CASE
    WHEN CURRENT_ROLE() = 'SYDNEY_ROLE'
        THEN UPPER(CUSTOMER_CITY) = 'SYDNEY'

    WHEN CURRENT_ROLE() = 'ORANGE_ROLE'
        THEN UPPER(CUSTOMER_CITY) = 'ORANGE'

    WHEN CURRENT_ROLE() = 'BRISBANE_ROLE'
        THEN UPPER(CUSTOMER_CITY) = 'BRISBANE'

    WHEN CURRENT_ROLE() = 'IPSWICH_ROLE'
        THEN UPPER(CUSTOMER_CITY) = 'IPSWICH'

    WHEN CURRENT_ROLE() = 'ACCOUNTADMIN'
        THEN TRUE

    ELSE FALSE
END;


-------- Apply policy

ALTER TABLE CUSTOMER_DB.CURATED.NSW_CUSTOMERS
ADD ROW ACCESS POLICY CITY_POLICY
ON (CUSTOMER_CITY);

ALTER TABLE CUSTOMER_DB.CURATED.QUEENSLAND_CUSTOMERS
ADD ROW ACCESS POLICY CITY_POLICY
ON (CUSTOMER_CITY);

